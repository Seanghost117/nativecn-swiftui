{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nativecn.dev/schemas/registry-item.json",
  "title": "NativeCN Registry Item",
  "type": "object",
  "required": [
    "name",
    "type",
    "title",
    "description",
    "stability",
    "dependencies",
    "files",
    "docs",
    "copyPaste"
  ],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "type": { "enum": ["foundation", "component"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "stability": { "enum": ["stable", "experimental"] },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "previewFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "docs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "copyPaste": {
      "type": "object",
      "required": ["destination"],
      "additionalProperties": false,
      "properties": {
        "destination": { "type": "string", "minLength": 1 }
      }
    }
  }
}

